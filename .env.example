OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-small
TOP_K=5
TEMPERATURE=0
# TEMPERATURE=0 is the desired value; LLM_SEND_TEMPERATURE=false means "do
# not send it to the API for the current model" - the current reasoning-
# tier model rejects an explicit temperature override, so the default is
# false. Set to true only when LLM_MODEL is switched to a model that
# actually supports temperature.
LLM_SEND_TEMPERATURE=false
COLLECTION_NAME=gumruk_mevzuati
MAX_CHUNK_CHARS=4000
CHROMA_PATH=chroma
